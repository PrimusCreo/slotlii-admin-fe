# Slotlii Admin FE — local / shared defaults
# Copy to `.env` (gitignored) and adjust if needed.
# Vite only exposes variables prefixed with `VITE_` to the browser.

# API
# Leave blank in local dev to use the Vite proxy at `/api` -> DEV_PROXY_TARGET.
# In prod, set the full origin including the `/api` prefix, e.g. https://api.slotlii.com/api
VITE_API_BASE_URL=

# Shown in the login screen, sidebar, and settings page.
VITE_APP_NAME=Slotlii

# Dev-only (vite.config.js) — not bundled into the client.
DEV_PROXY_TARGET=http://localhost:3000
DEV_SERVER_PORT=5173
