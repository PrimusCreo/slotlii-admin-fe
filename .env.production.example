# ==============================================
# Slotlii Admin FE — PRODUCTION Environment
# ==============================================
# Copy this file to `.env.production` (or set these vars in your hosting platform).
# Vite loads `.env.production` automatically when running `vite build`.
# Only `VITE_*` values are baked into the static bundle.

# API
# IMPORTANT: must include the `/api` prefix because the backend mounts routes
# under `/api/*` (e.g. POST /api/auth/login).
VITE_API_BASE_URL=https://api.slotlii.com

VITE_APP_NAME=Slotlii
